{
  "name": "e-faktura",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-e-faktura",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "icons:gen": "node tools/gen-icons.mjs",
    "codebooks:gen":"node tools/gen-tax-indicators.js docs/ujp/tax-indicators.txt src/app/core/ujp/tax-indicators.generated.ts",
    "deploy": "ng build && firebase deploy --only hosting,firestore,functions",
    "e2e": "node e2e/smoke.spec.mjs",
    "e2e:shots": "node e2e/screenshots.mjs",
    "e2e:live": "node e2e/live-probe.mjs",
    "e2e:overflow": "node e2e/overflow-check.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.30",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.30",
    "@angular/platform-server": "^20.3.30",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.30",
    "firebase": "^11.10.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.35",
    "@angular/cli": "^20.3.35",
    "@angular/compiler-cli": "^20.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  }
}
